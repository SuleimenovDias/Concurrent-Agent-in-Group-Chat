DATABASE_URL=postgresql+asyncpg://castle:castle@localhost:5432/castle_agent
OPENAI_API_KEY=replace_with_your_openai_key
LLM_PROVIDER=openai
ROUTER_MODEL=gpt-6-luna
EXECUTOR_MODEL=gpt-6.1-terra
ROUTER_REASONING_EFFORT=none
EXECUTOR_REASONING_EFFORT=low
ROUTER_MAX_OUTPUT_TOKENS=700
MAX_CONCURRENT_AGENTS=3
MAX_CONCURRENT_ROUTES=3
API_TIMEOUT_SECONDS=60
TASK_TIMEOUT_SECONDS=240
MAX_RETRIES=2
RETRY_BASE_SECONDS=1
MAX_OUTPUT_TOKENS=4096
CONTEXT_MESSAGES=30
CONTEXT_TASKS=20
RETENTION_DAYS=30
SCHEDULER_INTERVAL_SECONDS=0.5
ROUTING_STRUCTURED_OUTPUT=true
CORS_ORIGINS=["http://localhost:5173"]
DEMO_EXECUTION_DELAY_SECONDS=0
